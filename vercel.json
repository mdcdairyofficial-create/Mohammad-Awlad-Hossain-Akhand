{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mdccasebook.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://mdccasebook.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api/|uploads/|google[a-zA-Z0-9]+\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
